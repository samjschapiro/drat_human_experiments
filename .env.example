# Data directory path
DATA_DIR=/path/to/your/data

# Anthropic API key (required for LLM-based extraction)
ANTHROPIC_API_KEY=your-api-key-here

# Semantic Scholar API key (free, get at semanticscholar.org)
S2_API_KEY=your-semantic-scholar-api-key-here

# ── DRAT battery deploy (src/human_experiments/battery/deploy.sh, get_data.sh) ──
# Real values live in gitignored files at the repo root; never commit them.
#
# .env  (shared across environments)
SUPABASE_API_KEY=sbp_your-personal-access-token   # supabase.com/dashboard/account/tokens
VERCEL_API_KEY=your-vercel-token                  # vercel.com/account/tokens
#
# .env.dev and .env.prod  (one file per environment, same keys, different values)
#   SUPABASE_PROJECT_REF=<ref from supabase.com/dashboard/project/<ref>>
#   DB_PASSWORD=<that project's database password>
#   DATA_EXPORT_TOKEN=<openssl rand -hex 32; different per environment>
#   COMPLETION_URL=<where participants land after submitting>
